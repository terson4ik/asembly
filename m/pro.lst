     1                                  global _start
     2                                  
     3                                  section .data
     4                                  
     5                                  section .text
     6                                  ;
     7                                  ; [ebp+8] pointer to string
     8                                  ; [ebp+12] pointer to string
     9                                  ; returns eax==0 for false, eax== 1 for true
    10                                  match:
    11 00000000 55                              push ebp
    12 00000001 89E5                            mov ebp, esp
    13 00000003 83EC04                          sub esp, 4              ; variable I(index)
    14 00000006 56                              push esi
    15 00000007 57                              push edi
    16 00000008 8B7508                          mov esi, [ebp+8]        ; source
    17 0000000B 8B7D0C                          mov edi, [ebp+12]       ; pattern
    18 0000000E 803F00                          cmp byte [edi], 0       ; pattern end?
    19 00000011 7507                            jne .continue           ; if no then continue
    20 00000013 803E00                          cmp byte [esi], 0       ; if over, check over of source
    21 00000016 7457                            je .true                ; successfully 
    22 00000018 EB51                            jmp .false              ; fail
    23                                  .continue:
    24 0000001A 803F2A                          cmp byte [edi], '*'     ; it`s *?
    25 0000001D 752B                            jne .not_star 
    26 0000001F C745FC00000000                  mov dword [ebp-4], 0    ; I = 0
    27 00000026 47                              inc edi                 ; *->next
    28                                  .star_loop:
    29 00000027 89F0                            mov eax, esi            ; get source
    30 00000029 0345FC                          add eax, [ebp-4]
    31 0000002C 57                              push edi                ; pattern
    32 0000002D 50                              push eax                ; prepared source
    33 0000002E E8CDFFFFFF                      call match
    34 00000033 83C408                          add esp, 8
    35 00000036 85C0                            test eax, eax           ; fail?
    36 00000038 753A                            jnz .quit               ; if no, then true
    37 0000003A 89F0                            mov eax, esi            ; now we need to check
    38 0000003C 0345FC                          add eax, [ebp-4]        ; example is over?
    39 0000003F 8A08                            mov cl, [eax]
    40 00000041 84C9                            test cl, cl
    41 00000043 7426                            jz .false
    42 00000045 FE45FC                          inc [ebp-4]             ; I+1
    43 00000048 EBDD                            jmp .star_loop
    44                                  .not_star:
    45 0000004A 803F3F                          cmp byte [edi], '?'     ; if ? then skip one character
    46 0000004D 7508                            jne .default            ; if no go to check
    47 0000004F 8A0E                            mov cl, [esi]
    48 00000051 84C9                            test cl, cl
    49 00000053 7416                            jz .false
    50 00000055 EB06                            jmp short .next
    51                                  .default:
    52 00000057 8A06                            mov al, [esi]           ; get char
    53 00000059 3807                            cmp byte [edi], al      ; check
    54 0000005B 750E                            jne .false
    55 0000005D 47                      .next:  inc edi                 ; next char in pattern
    56 0000005E 46                              inc esi
    57 0000005F 57                              push edi
    58 00000060 56                              push esi
    59 00000061 E89AFFFFFF                      call match              ; after this, eax contain final value
    60 00000066 83C408                          add esp, 8
    61 00000069 EB09                            jmp .quit
    62 0000006B 31C0                    .false: xor eax, eax
    63 0000006D EB05                            jmp short .quit
    64 0000006F B801000000              .true:  mov eax, 1
    65 00000074 5F                      .quit:  pop edi
    66 00000075 5E                              pop esi
    67 00000076 89EC                            mov esp, ebp
    68 00000078 5D                              pop ebp
    69 00000079 C3                              ret
    70                                  
    71 0000007A 5E                      _start: pop esi
    72 0000007B 83FE03                          cmp esi, 3      ; prog string pattern
    73 0000007E 740C                            je .param_count_good
    74 00000080 B801000000                      mov eax, 1
    75 00000085 BB01000000                      mov ebx, 1
    76 0000008A CD80                            int 80h
    77                                  .param_count_good:
    78 0000008C 5E                              pop esi         ; remove prog
    79 0000008D 5E                              pop esi         ; string
    80 0000008E 5F                              pop edi         ; pattern
    81 0000008F 57                              push edi
    82 00000090 56                              push esi
    83 00000091 E86AFFFFFF                      call match
    84 00000096 83C408                          add esp, 8
    85 00000099 85C0                            test eax, eax
    86 0000009B 750C                            jnz true
    87 0000009D B801000000                      mov eax, 1
    88 000000A2 BBE4000000                      mov ebx, 228
    89 000000A7 CD80                            int 80h
    90                                  true:   
    91 000000A9 B801000000                      mov eax, 1
    92 000000AE 31DB                            xor ebx, ebx
    93 000000B0 CD80                            int 80h
